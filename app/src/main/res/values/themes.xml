<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CarTube" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">#FFDAD6</item>
        <item name="colorOnPrimaryContainer">#410002</item>
        <item name="colorSecondary">@color/brand_dark</item>
        <!-- Neutral greys instead of Material's default lilac, like YouTube. -->
        <item name="colorSecondaryContainer">#E5E5E5</item>
        <item name="colorOnSecondaryContainer">#0F0F0F</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#F9F9F9</item>
        <item name="colorSurfaceContainer">#F2F2F2</item>
        <item name="colorSurfaceContainerHigh">#ECECEC</item>
        <item name="colorSurfaceContainerHighest">#E5E5E5</item>
        <item name="colorOnSurface">#0F0F0F</item>
        <item name="colorOnSurfaceVariant">#606060</item>
        <item name="colorOutline">#CCCCCC</item>
        <item name="colorOutlineVariant">#E5E5E5</item>
    </style>

    <style name="Theme.CarTube.Player">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.CarTube.TV" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/tv_brand</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>

    <style name="ThemeOverlay.CarTube.Amoled" parent="">
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="colorSurfaceContainer">#0D0D0D</item>
        <item name="colorSurfaceContainerHigh">#161616</item>
        <item name="colorSurfaceContainerHighest">#1F1F1F</item>
    </style>

    <style name="ThemeOverlay.CarTube.CastButton" parent="ThemeOverlay.Material3.Dark" />

    <style name="TextAppearance.CarTube.Logo" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="CarTube.DurationBadge" parent="">
        <item name="android:background">@drawable/duration_background</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CarTube.ActionButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <style name="CarTube.SubscribeButton" parent="Widget.Material3.Button">
        <item name="android:text">@string/subscribe</item>
        <item name="backgroundTint">@color/subscribe_background</item>
        <item name="android:textColor">@color/subscribe_text</item>
    </style>

    <style name="CarTube.SheetItem" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:drawablePadding">20dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="drawableTint">?attr/colorOnSurface</item>
    </style>

    <style name="CarTube.SortButton" parent="Widget.Material3.Button.TextButton">
        <item name="icon">@drawable/ic_expand</item>
        <item name="iconGravity">end</item>
        <item name="iconSize">18dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="CarTube.StatBox" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/description_background</item>
    </style>

    <style name="CarTube.StatValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleLarge</item>
    </style>

    <style name="CarTube.StatLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="ShapeRounded12" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
</resources>
